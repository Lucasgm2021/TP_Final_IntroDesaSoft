FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .

# Install dependencies and add gunicorn for production hosting
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Inform Docker that the container listens on port 10000 at runtime
EXPOSE 10000

# Use Gunicorn to run your Flask application dynamically on Render's assigned port
CMD ["gunicorn", "app:app", "--bind", "0.0.0.0:10000"]