# 1. Use an official, lightweight Python image
FROM python:3.11-slim

# 2. Set the working directory inside the container
WORKDIR /app

# 3. Copy only requirements first (allows Docker to cache dependencies)
COPY requirements.txt .

# 4. Install the backend-specific libraries (Flask, SQLAlchemy, PyMySQL)
RUN pip install --no-cache-dir -r requirements.txt

# 5. Copy the rest of your backend application code
COPY . .

# 6. Document that the backend container listens on port 8000
EXPOSE 5001

# 7. Start the Flask application binding to all network interfaces
CMD ["python", "app.py"]